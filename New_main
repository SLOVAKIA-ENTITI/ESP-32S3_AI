void setup() {
  Serial.begin(115200);
  delay(1000);
  Serial.println("\n\n----- ESP32-S3 Gemini Inteligentný Hlasový Asistent -----");

  pinMode(PTT_BUTTON_PIN, INPUT_PULLUP);

  audioBuffer = (int16_t*)malloc(BUFFER_SIZE * sizeof(int16_t));
  if (audioBuffer == nullptr) {
    Serial.println("[STOP] Nedostatok pamäte RAM pre audio buffer!");
    while(1);
  }

  setupWiFi();
  
  // 1. Inicializácia reproduktora cez tvoje rádio (používa I2S_NUM_0)
  audio.setPinout(I2S_BCLK, I2S_LRC, I2S_DOUT);
  audio.setVolume(18); 

  // 2. Inicializácia mikrofónu cez moderný oficiálny I2S driver (používa bezpečne I2S_NUM_1)
  initMicrophoneStandard();

  Serial.println("\n[OK] Systém beží bezpečne a stabilne!");
  delay(500); // počkáme kým sa audio inicializuje
  sendTextToGemini("Si hlasová AI asistentka menom Pal (slečna). Hovoríš výhradne po slovensky a dostávaš otázky v slovenčine. Si priateľská, stručná a nápomocná. Toto je tvoja prvá správa po spustení - predstav sa menom a povedz že si pripravená na konverzáciu. Maximálne 1-2 krátke vety.");
}

void loop() {
  if (!isRecording) {
    audio.loop(); 
  }

  // LOGIKA PUSH-TO-TALK
  if (digitalRead(PTT_BUTTON_PIN) == LOW) {
    if (!isRecording) {
      audio.stopSong(); 
      isRecording = true;
      audioBufferIndex = 0;
      Serial.println("\n🎙️ [NAHRÁVAM...] Môžete hovoriť...");
    }

    // Čítanie z mikrofónu cez nový I2S Standard Driver
    if (audioBufferIndex < BUFFER_SIZE) {
      size_t bytes_read = 0;
      int16_t temp_buffer[64];
      
      // Bezpečné čítanie z priradeného rx_handle na Porte 1
      if (i2s_channel_read(rx_handle, temp_buffer, sizeof(temp_buffer), &bytes_read, 10) == ESP_OK) {
        size_t samples_read = bytes_read / 2;
        for (size_t i = 0; i < samples_read; i++) {
          if (audioBufferIndex < BUFFER_SIZE) {
            audioBuffer[audioBufferIndex++] = temp_buffer[i];
          }
        }
      }
    }
    
  } else {
    if (isRecording) {
      isRecording = false;
      Serial.printf("🎙️ [KONIEC NAHRÁVANIA] Uložených %d vzoriek.\n", audioBufferIndex);
      
      if (audioBufferIndex > 2000) { 
        sendAudioToGemini();
      } else {
        Serial.println("[INFO] Nahrávka príliš krátka, ignorujem.");
      }
    }
  }

  if (Serial.available() > 0 && !isRecording) {
    String input = Serial.readStringUntil('\n');
    input.trim();
    if (input.length() > 0) {
      Serial.print("\nTvoja otázka z monitora: ");
      Serial.println(input);
      sendTextToGemini(input);
    }
  }
}
