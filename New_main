  audio.connecttohost(ttsUrl.c_str());
}

String base64Encode(byte* input, size_t inputLen) {
  static const char base64chars[] = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
  String output = "";
  output.reserve((inputLen * 4 / 3) + 2);
  
  size_t i = 0;
  while (i < inputLen) {
    uint32_t b0 = (i < inputLen) ? input[i++] : 0;
    uint32_t b1 = (i < inputLen) ? input[i++] : 0;
    uint32_t b2 = (i < inputLen) ? input[i++] : 0;
    
    uint32_t triple = (b0 << 16) | (b1 << 8) | b2;
    
    output += base64chars[(triple >> 18) & 0x3F];
    output += base64chars[(triple >> 12) & 0x3F];
    output += base64chars[(triple >> 6) & 0x3F];
    output += base64chars[triple & 0x3F];
  }
  
  size_t remainder = inputLen % 3;
  if (remainder == 1) {
    output.setCharAt(output.length() - 1, '=');
    output.setCharAt(output.length() - 2, '=');
  } else if (remainder == 2) {
    output.setCharAt(output.length() - 1, '=');
  }
  return output;
}

void sendAudioToGemini() {
  WiFiClientSecure client;
  client.setInsecure();

  if (!client.connect(geminiHost, httpsPort)) {
    Serial.println("[CHYBA] Pripojenie k Gemini zlyhalo.");
    return;
  }

  Serial.println("\nSpracovávam zvuk (generujem WAV) a odosielam do Gemini...");

  // 1. GENEROVANIE WAV HLAVIČKY (44 bajtov)
  size_t numSamples = audioBufferIndex;
  size_t dataSize = numSamples * 2; 
  size_t fileSize = 36 + dataSize;
  int32_t sampleRate = SAMPLE_RATE;
  int32_t byteRate = sampleRate * 2; 

  byte wavHeader[44];
  wavHeader[0] = 'R'; wavHeader[1] = 'I'; wavHeader[2] = 'F'; wavHeader[3] = 'F';
  wavHeader[4] = (byte)(fileSize & 0xFF);
  wavHeader[5] = (byte)((fileSize >> 8) & 0xFF);
  wavHeader[6] = (byte)((fileSize >> 16) & 0xFF);
  wavHeader[7] = (byte)((fileSize >> 24) & 0xFF);
  wavHeader[8] = 'W'; wavHeader[9] = 'A'; wavHeader[10] = 'V'; wavHeader[11] = 'E';
  wavHeader[12] = 'f'; wavHeader[13] = 'm'; wavHeader[14] = 't'; wavHeader[15] = ' ';
  wavHeader[16] = 16; wavHeader[17] = 0; wavHeader[18] = 0; wavHeader[19] = 0; 
  wavHeader[20] = 1;  wavHeader[21] = 0; 
  wavHeader[22] = 1;  wavHeader[23] = 0; 
  wavHeader[24] = (byte)(sampleRate & 0xFF);
  wavHeader[25] = (byte)((sampleRate >> 8) & 0xFF);
  wavHeader[26] = (byte)((sampleRate >> 16) & 0xFF);
  wavHeader[27] = (byte)((sampleRate >> 24) & 0xFF);
  wavHeader[28] = (byte)(byteRate & 0xFF);
  wavHeader[29] = (byte)((byteRate >> 8) & 0xFF);
  wavHeader[30] = (byte)((byteRate >> 16) & 0xFF);
  wavHeader[31] = (byte)((byteRate >> 24) & 0xFF);
  wavHeader[32] = 2;  wavHeader[33] = 0; 
  wavHeader[34] = 16; wavHeader[35] = 0; 
  wavHeader[36] = 'd'; wavHeader[37] = 'a'; wavHeader[38] = 't'; wavHeader[39] = 'a';
  wavHeader[40] = (byte)(dataSize & 0xFF);
  wavHeader[41] = (byte)((dataSize >> 8) & 0xFF);
  wavHeader[42] = (byte)((dataSize >> 16) & 0xFF);
  wavHeader[43] = (byte)((dataSize >> 24) & 0xFF);

  size_t totalWavBytes = 44 + dataSize;
  byte* fullWavBuffer = (byte*)malloc(totalWavBytes);
  if (fullWavBuffer == nullptr) {
    Serial.println("[CHYBA] Nedostatok RAM pre vytvorenie WAV súboru!");
    return;
  }

  memcpy(fullWavBuffer, wavHeader, 44);
  memcpy(fullWavBuffer + 44, (byte*)audioBuffer, dataSize);

  String base64Audio = base64Encode(fullWavBuffer, totalWavBytes);
  free(fullWavBuffer); 

  // ─── KRITICKÁ ZMENA: TEXT IDE AKO PRVÝ, AUDIO AKO DRUHÉ ───
  // ─── STRIKTNÝ JSON S INTEGROVANÝM GOOGLE VYHĽADÁVANÍM ───
  // ─── UPRAVENÝ STRIKTNÝ JSON S ANGLICKOU INŠTRUKCIOU PRE MAXIMÁLNU SPOĽAHLIVOSŤ ───
  String jsonBody = "{\n";
  jsonBody += "  \"contents\": [{\n";
  jsonBody += "    \"parts\": [\n";
  jsonBody += "      {\n";
  // 🔥 Zmenili sme prompt na nekompromisný anglický príkaz – model takto na 100% spracuje audio a použije Google Search
  jsonBody += "        \"text\": \"Listen carefully to the attached audio file. You have integrated Google Search tool, so use it if the user asks about current events, facts, weather, or time-sensitive data. Answer the user's question from the audio precisely, very briefly (maximum 2 short sentences), and exclusively in Slovak language with full diacritics (mäkčene, dĺžne).\"\n";
  jsonBody += "      },\n";
  jsonBody += "      {\n";
  jsonBody += "        \"inlineData\": {\n";
  jsonBody += "          \"mimeType\": \"audio/wav\",\n";
  jsonBody += "          \"data\": \"" + base64Audio + "\"\n";
  jsonBody += "        }\n";
  jsonBody += "      }\n";
  jsonBody += "    ]\n";
  jsonBody += "  }],\n";
  jsonBody += "  \"tools\": [{\"googleSearch\": {}}],\n"; 
  jsonBody += "  \"generationConfig\": {\n";
  jsonBody += "    \"temperature\": 0.4,\n";
  jsonBody += "    \"responseMimeType\": \"text/plain\"\n";
  jsonBody += "  }\n";
  jsonBody += "}";

  String url = "/v1beta/models/" + String(geminiModel) + ":generateContent?key=" + String(geminiApiKey);
  client.print("POST " + url + " HTTP/1.1\r\n");
  client.print("Host: " + String(geminiHost) + "\r\n");
  client.print("Content-Type: application/json\r\n");
  client.print("Content-Length: " + String(jsonBody.length()) + "\r\n");
  client.print("Connection: close\r\n\r\n");
  client.print(jsonBody);
  client.flush();

  unsigned long timeout = millis();
  while (client.available() == 0) {
    if (millis() - timeout > 20000) {
      client.stop();
      Serial.println("[CHYBA] Timeout zo servera Gemini.");
      return;
    }
    delay(10);
  }

  while (client.connected()) {
    String line = client.readStringUntil('\n');
    if (line == "\r") break;
  }

  String response = client.readString();
  client.stop();

  int jsonStart = response.indexOf('{');
  if (jsonStart != -1) response = response.substring(jsonStart);

  JsonDocument responseDoc; 
  DeserializationError error = deserializeJson(responseDoc, response);

  if (!error && responseDoc.containsKey("candidates")) {
    const char* textResponse = responseDoc["candidates"][0]["content"]["parts"][0]["text"];
    if (textResponse) {
      Serial.println("\n=== GEMINI ODPOVEDÁ: ===");
      Serial.println(textResponse);
      Serial.println("========================\n");
      playSpeech(textResponse);
    }
  } else {
    Serial.println("[CHYBA] Nepodarilo sa naparsovať hlasovú odpoveď.");
  }
}
