// ═══════════════════════════════════════════════════════════════════
//  BOTTOM BAR — fixed: no-alarm state, force redraw after save
// ═══════════════════════════════════════════════════════════════════
void drawBottomBar(int h, int m, int s) {
  // ── find next upcoming alarm ──────────────────────────────────────
  int nextH = -1, nextM = -1, minLeft = -1;
  int wd = ntpClient.getDay();

  for (int dd = 0; dd < 7 && minLeft < 0; dd++) {
    int checkWd = (wd + dd) % 7;
    for (int i = 0; i < MAX_ALARMS; i++) {
      if (!alarms[i].enabled)          continue;
      if (!alarms[i].days[checkWd])    continue;
      int mins = dd * 1440 + alarms[i].hour * 60 + alarms[i].minute
                 - (h * 60 + m);
      if (mins <= 0) continue;
      if (minLeft < 0 || mins < minLeft) {
        minLeft = mins;
        nextH   = alarms[i].hour;
        nextM   = alarms[i].minute;
      }
    }
    if (minLeft > 0) break;
  }

  // ── NTP dot + static labels — draw on first call only ────────────
  bool firstDraw = (prevMinLeft == -2);
  if (firstDraw) {
   // tft.fillCircle(30, 182, 3, ntpSynced ? C_LIVE : C_RED);
    //tft.setTextSize(1);
    //tft.setTextColor(ntpSynced ? C_LIVE : C_RED);
    //tft.setCursor(38, 178);
   // tft.print(ntpSynced ? "SYNCED" : "NO NTP");
  }

  // ── alarm time + countdown — redraw when value changes ───────────
  // encode state: -1 means no alarm, otherwise minutes left
  int newMinLeft = (nextH >= 0) ? minLeft : -1;

  if (newMinLeft != prevMinLeft || firstDraw) {
    // erase alarm area completely
    tft.fillRect(0, 196, 186, 42, C_BTMBAR);

    // redraw "NEXT ALARM" label
    tft.setTextSize(1);
    tft.setTextColor(C_DIM);
    tft.setCursor(10, 185);
    tft.print("NEXT ALARM");

    if (nextH >= 0) {
      // alarm time
      char buf[8];
      tft.setTextSize(2);
      tft.setTextColor(C_ACCENT);
      tft.setCursor(10, 203);
      snprintf(buf, sizeof(buf), "%02d:%02d", nextH, nextM);
      tft.print(buf);

      // countdown
      tft.setTextSize(1);
      tft.setTextColor(C_DIM);
      tft.setCursor(76, 208);
      char cbuf[20];
      snprintf(cbuf, sizeof(cbuf), "in %dh %02dm", minLeft / 60, minLeft % 60);
      tft.print(cbuf);
    } else {
      // no alarms enabled
      tft.setTextSize(1);
      tft.setTextColor(C_DIM);
      tft.setCursor(10, 203);
      tft.print("none active");
    }

    prevMinLeft = newMinLeft;
  }

  // ── progress bar ─────────────────────────────────────────────────
  float progress = (h * 3600.0f + m * 60.0f + s) / 86400.0f;
  int barFill = (int)(progress * 126.0f);

  if (barFill != prevBtmBar) {
    if (barFill > prevBtmBar && prevBtmBar >= 0) {
      // bar grew — paint only the new strip, no rounding
      tft.fillRect(186 + prevBtmBar, 193, barFill - prevBtmBar, 6, C_ACCENT);
    } else {
      // full redraw — erase with flat rect, then paint flat rect
      tft.fillRect(186, 193, 126, 6, C_RULE);
      if (barFill > 0) tft.fillRect(186, 193, barFill, 6, C_ACCENT);
    }
    prevBtmBar = barFill;
  }

  // ── day labels ───────────────────────────────────────────────────
  static int prevTodayWd = -1;
  int todayWd = ntpClient.getDay();
  if (todayWd != prevTodayWd || firstDraw) {
    tft.fillRect(180, 218, 140, 14, C_BTMBAR);
    const char* dnames[] = {"SUN","MON","TUE","WED","THU","FRI","SAT"};
    for (int i = 0; i < 7; i++) {
      tft.setTextColor(i == todayWd ? C_ACCENT : C_DIM);
      tft.setTextSize(1);
      tft.setCursor(180 + i * 20, 220);
      tft.print(dnames[i]);
    }
    tft.fillRect(180, 232, 140, 2, C_BTMBAR);
    tft.fillRect(180 + todayWd * 20, 232, 14, 2, C_ACCENT);
    prevTodayWd = todayWd;
  }
}
