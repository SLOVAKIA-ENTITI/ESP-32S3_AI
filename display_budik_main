void drawSunIcon(int cx, int cy, uint16_t col) {
  tft.fillCircle(cx, cy, 5, col);
  for (int a = 0; a < 360; a += 45) {
    float r = a * PI / 180.0f;
    tft.drawLine(cx+cos(r)*7, cy+sin(r)*7, cx+cos(r)*10, cy+sin(r)*10, col);
  }
}
void drawCloudIcon(int cx, int cy, uint16_t col) {
  tft.fillCircle(cx-4, cy,   5, col);
  tft.fillCircle(cx+3, cy-2, 6, col);
  tft.fillCircle(cx+8, cy,   4, col);
  tft.fillRect(cx-4, cy, 14, 5, col);
}
void drawRainIcon(int cx, int cy, uint16_t col) {
  drawCloudIcon(cx, cy-4, col);
  for (int i = 0; i < 3; i++)
    tft.drawLine(cx-2+i*5, cy+5, cx-4+i*5, cy+10, col);
}
void drawSnowIcon(int cx, int cy, uint16_t col) {
  tft.drawLine(cx-7, cy, cx+7, cy, col);
  tft.drawLine(cx, cy-7, cx, cy+7, col);
  tft.drawLine(cx-5, cy-5, cx+5, cy+5, col);
  tft.drawLine(cx+5, cy-5, cx-5, cy+5, col);
  tft.fillCircle(cx, cy, 2, col);
}

// ═══════════════════════════════════════════════════════════════════
//  DATE DECODER
// ═══════════════════════════════════════════════════════════════════
void decodeDate(unsigned long epoch, int &yr, int &mo, int &day) {
  uint32_t rem = epoch / 86400UL;
  yr = 1970;
  while (true) {
    bool leap = (yr%4==0 && (yr%100!=0 || yr%400==0));
    uint32_t dy = leap ? 366 : 365;
    if (rem < dy) break;
    rem -= dy; yr++;
  }
  bool leap = (yr%4==0 && (yr%100!=0 || yr%400==0));
  static const uint8_t dpm[] = {31,28,31,30,31,30,31,31,30,31,30,31};
  mo = 1;
  while (true) {
    uint8_t dim = dpm[mo-1] + (mo==2 && leap ? 1 : 0);
    if (rem < dim) break;
    rem -= dim; mo++;
  }
  day = rem + 1;
}

