void saveAlarms() {
  prefs.begin("alarms", false);
  for (int i = 0; i < MAX_ALARMS; i++) {
    char key[16];
    snprintf(key, sizeof(key), "ah%d", i); prefs.putInt(key,  alarms[i].hour);
    snprintf(key, sizeof(key), "am%d", i); prefs.putInt(key,  alarms[i].minute);
    snprintf(key, sizeof(key), "ae%d", i); prefs.putBool(key, alarms[i].enabled);
    for (int d = 0; d < 7; d++) {
      snprintf(key, sizeof(key), "ad%d%d", i, d);
      prefs.putBool(key, alarms[i].days[d]);
    }
  }
  // save location too
  prefs.putString("lat", weatherLat);
  prefs.putString("lon", weatherLon);
  prefs.end();
}
void handleSaveLoc() {
  if (!server.hasArg("plain")) { server.send(400, "text/plain", "No body"); return; }

  DynamicJsonDocument doc(256);
  DeserializationError err = deserializeJson(doc, server.arg("plain"));
  if (err) { server.send(400, "text/plain", "Bad JSON"); return; }

  String lat = doc["lat"].as<String>();
  String lon = doc["lon"].as<String>();

  float latF = lat.toFloat();
  float lonF = lon.toFloat();
  if (latF < -90 || latF > 90 || lonF < -180 || lonF > 180) {
    server.send(400, "text/plain", "Invalid coordinates");
    return;
  }

  strncpy(weatherLat, lat.c_str(), sizeof(weatherLat) - 1);
  strncpy(weatherLon, lon.c_str(), sizeof(weatherLon) - 1);
  saveAlarms();

  // ── force full weather redraw by resetting cached values ─────────
  wTemp  = -999;
  wHumid = -999;
  wWind  = -999;
  wDesc  = "";
  for (int i = 0; i < 3; i++) fc[i] = -999;

  // ── respond to browser first, then fetch ─────────────────────────
  server.send(200, "text/plain", "OK");
  Serial.printf("LOCATION updated: %s, %s — fetching weather...\n", weatherLat, weatherLon);

  // ── now fetch with new coordinates ───────────────────────────────
  fetchWeather();
}

void loadAlarms() {
  for (int i = 0; i < MAX_ALARMS; i++) {
    alarms[i].hour    = 7;
    alarms[i].minute  = 0;
    alarms[i].enabled = false;
    for (int d = 0; d < 7; d++) alarms[i].days[d] = true;
  }
  prefs.begin("alarms", true);
  for (int i = 0; i < MAX_ALARMS; i++) {
    char key[16];
    snprintf(key, sizeof(key), "ah%d", i); alarms[i].hour    = prefs.getInt(key,  7);
    snprintf(key, sizeof(key), "am%d", i); alarms[i].minute  = prefs.getInt(key,  0);
    snprintf(key, sizeof(key), "ae%d", i); alarms[i].enabled = prefs.getBool(key, false);
    for (int d = 0; d < 7; d++) {
      snprintf(key, sizeof(key), "ad%d%d", i, d);
      alarms[i].days[d] = prefs.getBool(key, true);
    }
  }
  // load location
  String lat = prefs.getString("lat", "49.30");
  String lon = prefs.getString("lon", "18.78");
  strncpy(weatherLat, lat.c_str(), sizeof(weatherLat) - 1);
  strncpy(weatherLon, lon.c_str(), sizeof(weatherLon) - 1);
  prefs.end();
}

