// ═══════════════════════════════════════════════════════════════════
//  LOOP
// ═══════════════════════════════════════════════════════════════════
void loop() {
  server.handleClient();

  if (WiFi.status() != WL_CONNECTED) {
    ntpSynced = false;
    WiFi.reconnect();
    unsigned long t = millis();
    while (WiFi.status() != WL_CONNECTED && millis() - t < 10000) delay(500);
    if (WiFi.status() == WL_CONNECTED) {
      ntpClient.update();
      ntpSynced = true;
    }
  }

  ntpClient.update();

if (millis() - lastDHTms > DHT_INTERVAL_MS) {
    float t = dht.readTemperature();
    float h2 = dht.readHumidity();
    if (!isnan(t) && !isnan(h2)) {
      currentTemp  = t;
      currentHum = h2;
      drawIndoor();   // only redraws if values changed
    }
    lastDHTms = millis();
  }

  int h  = ntpClient.getHours();
  int m  = ntpClient.getMinutes();
  int s  = ntpClient.getSeconds();
  int wd = ntpClient.getDay();

  int yr, mo, day;
  decodeDate(ntpClient.getEpochTime(), yr, mo, day);

  if (millis() - lastWeatherMs > WEATHER_INTERVAL_MS) fetchWeather();

  if (h != prevH || m != prevM || day != prevDay) {
    drawTopBar(h, m, wd, day, mo, yr);
    prevDay = day;
  }

  if (h != prevH || m != prevM || s != prevS) {
    drawClock(h, m, s);
    drawBottomBar(h, m, s);
    prevH = h; prevM = m; prevS = s;
  }

  checkAlarms(h, m, s, wd);
  delay(200);
}

// ═══════════════════════════════════════════════════════════════════
//  ALARM CHECK
// ═══════════════════════════════════════════════════════════════════

// buzzer/LED pattern: three short bursts then a long one, repeating
// pattern in ms: ON 80 | OFF 60 | ON 80 | OFF 60 | ON 80 | OFF 200 | ON 400 | OFF 300
// total cycle = 1260ms
#define PAT_LEN 8
const uint16_t PAT_MS[PAT_LEN]  = { 80, 60, 80, 60, 80, 200, 400, 300 };
const bool     PAT_ON[PAT_LEN]  = {  1,  0,  1,  0,  1,   0,   1,   0 };

void updateBuzzPattern() {
  // where are we inside the current cycle?
  unsigned long cycle = 0;
  for (int i = 0; i < PAT_LEN; i++) cycle += PAT_MS[i];  // = 1260ms

  unsigned long pos = (millis() - alarmStart) % cycle;
  unsigned long acc = 0;
  for (int i = 0; i < PAT_LEN; i++) {
    acc += PAT_MS[i];
    if (pos < acc) {
      digitalWrite(BUZZER,   PAT_ON[i] ? HIGH : LOW);
      digitalWrite(LED_BUZZ, PAT_ON[i] ? HIGH : LOW);
      return;
    }
  }
}

void checkAlarms(int h, int m, int s, int wd) {
  if (alarmRinging) {
    // button press stops alarm immediately
    if (digitalRead(BTN_STOP) == LOW) {
      stopAlarm();
      return;
    }

    // auto-stop after duration
    if (millis() - alarmStart > ALARM_DURATION_MS) {
      stopAlarm();
      return;
    }

    // buzzer + LED pattern (bz bz bz bzzzz ...)
    updateBuzzPattern();

    // flash top bar red in sync with the long buzz (PAT index 6)
    unsigned long cycle = 0;
    for (int i = 0; i < PAT_LEN; i++) cycle += PAT_MS[i];
    unsigned long pos = (millis() - alarmStart) % cycle;
    unsigned long longBuzzStart = 0;
    for (int i = 0; i < 6; i++) longBuzzStart += PAT_MS[i];

    if (pos >= longBuzzStart && pos < longBuzzStart + PAT_MS[6]) {
      // during long buzz — show red WAKE UP bar
      tft.fillRect(0, 0, 320, 22, C_RED);
      tft.setTextSize(2);
      tft.setTextColor(ILI9341_WHITE);
      tft.setCursor(80, 5);
      tft.print("WAKE  UP!");
    } else if (pos < 10) {
      // just after cycle reset — restore top bar
      int yr2, mo2, day2;
      decodeDate(ntpClient.getEpochTime(), yr2, mo2, day2);
      drawTopBar(h, m, wd, day2, mo2, yr2);
    }

    return;
  }

  // button does nothing when no alarm ringing
  if (s != 0) return;

  for (int i = 0; i < MAX_ALARMS; i++) {
    if (!alarms[i].enabled)    continue;
    if (alarms[i].hour   != h) continue;
    if (alarms[i].minute != m) continue;
    if (!alarms[i].days[wd])   continue;
    alarmRinging = true;
    ringAlarmIdx = i;
    alarmStart   = millis();
    Serial.printf("ALARM %d fired!\n", i);
    break;
  }
}

void stopAlarm() {
  alarmRinging = false;
  digitalWrite(BUZZER,   LOW);
  digitalWrite(LED_BUZZ, LOW);
  ringAlarmIdx = -1;

  drawStaticLayout();

  memset(prevClockStr, ' ', sizeof(prevClockStr));
  memset(prevSecStr,   ' ', sizeof(prevSecStr));
  prevBarFill = -1;
  prevBtmBar  = -1;
  prevMinLeft = -2;
  prevH = -1; prevM = -1; prevS = -1;

  int h  = ntpClient.getHours();
  int m  = ntpClient.getMinutes();
  int s  = ntpClient.getSeconds();
  int wd = ntpClient.getDay();
  int yr, mo, day;
  decodeDate(ntpClient.getEpochTime(), yr, mo, day);

  drawTopBar(h, m, wd, day, mo, yr);
  drawClock(h, m, s);
  drawBottomBar(h, m, s);
  prevIndoorTemp[0]  = ' ';
prevIndoorHumid[0] = ' ';
}
