    server.send(400, "text/plain", "No body");
    return;
  }

  DynamicJsonDocument doc(2048);
  DeserializationError err = deserializeJson(doc, server.arg("plain"));
  if (err) {
    server.send(400, "text/plain", "Bad JSON");
    return;
  }

  for (int i = 0; i < MAX_ALARMS && i < (int)doc.size(); i++) {
    alarms[i].hour    = doc[i]["hour"].as<int>();
    alarms[i].minute  = doc[i]["minute"].as<int>();
    alarms[i].enabled = doc[i]["enabled"].as<bool>();
    for (int d = 0; d < 7; d++)
      alarms[i].days[d] = doc[i]["days"][d].as<bool>();
  }

  saveAlarms();

  // force full bottom bar redraw on next tick
  prevMinLeft = -2;

  server.send(200, "text/plain", "OK");
  Serial.println("WEB: alarms saved");
}

void setupWebServer() {
  server.on("/",     HTTP_GET,  handleRoot);
  server.on("/time", HTTP_GET,  handleTime);
  server.on("/save", HTTP_POST, handleSave);
   server.on("/saveloc", HTTP_POST, handleSaveLoc);
  server.begin();
  Serial.print("Web server: http://");
  Serial.println(WiFi.localIP());
  
}

